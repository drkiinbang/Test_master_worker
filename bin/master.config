# Master Configuration
# ==============================================================================
#
# 파일 형식 설명:
# - '#'으로 시작하는 줄은 주석
# - 'key=value' 형식의 줄은 런타임 설정
# - 'ip,username,worker_path,ssh_port' 형식의 줄은 원격 워커 설정
#
# ==============================================================================

# ===== 마스터 서버 설정 (Master Server Settings) =====

# drain_seconds: 모든 작업 완료 후 추가 워커 연결을 기다리는 시간 (초)
# 설명: 모든 청크 처리가 완료된 후, 지연된 워커들이 결과를 보낼 수 있도록 대기하는 시간
# 권장값: 3-10초 (네트워크 지연 고려)
drain_seconds=3

# master_starvation_seconds: 워커 부족 상황 감지 임계 시간 (초)
# 설명: 이 시간 동안 진행 상황이 없으면 비상 워커를 자동 생성
# 권장값: 20-60초 (작업 복잡도에 따라)
master_starvation_seconds=60

# emergency_local_spawn_max: 자동 생성 가능한 최대 비상 워커 수
# 설명: 워커 부족 시 자동으로 생성할 수 있는 로컬 워커의 최대 개수
# 권장값: 2-5개 (시스템 리소스 고려)
emergency_local_spawn_max=5

# run_local_worker_on_master: 마스터 시작 시 로컬 워커 자동 실행 여부
# 설명: true이면 마스터 서버 시작 시 자동으로 로컬 워커를 새 창에서 실행
# 값: true/false, yes/no, 1/0, on/off
run_local_worker_on_master=true

# ===== SSH 원격 연결 설정 (SSH Remote Connection Settings) =====

# ssh_connect_timeout_sec: SSH 연결 타임아웃 (초)
# 설명: 원격 서버에 SSH 연결을 시도할 때의 최대 대기 시간
# 권장값: 5-15초
ssh_connect_timeout_sec=5

# ssh_server_alive_interval_sec: SSH 연결 유지 확인 간격 (초)
# 설명: SSH 연결이 살아있는지 확인하는 주기
# 권장값: 5-30초
ssh_server_alive_interval_sec=5

# ssh_server_alive_count_max: SSH 연결 확인 최대 실패 횟수
# 설명: 연결 확인에 이 횟수만큼 실패하면 연결 종료
# 권장값: 2-5회
ssh_server_alive_count_max=2

# ssh_batch_mode: SSH 배치 모드 사용 여부
# 설명: true이면 패스워드 입력 프롬프트 없이 키 기반 인증만 사용
# 권장값: true (자동화를 위해)
ssh_batch_mode=true

# ssh_strict_host_key: SSH 호스트 키 검증 정책
# 설명: 알려지지 않은 호스트에 대한 연결 정책
# 값: yes(엄격), no(허용), accept-new(새 호스트만 허용)
# 권장값: accept-new (보안과 편의성 균형)
ssh_strict_host_key=accept-new

# ===== 워커 모니터링 설정 =====

# heartbeat_interval_seconds: 하트비트 시간 간격  (seconds)
heartbeat_interval_seconds=10

# heartbeat_timeout_seconds: 이 시간동안 신호가 없으면 fail
heartbeat_timeout_seconds=30

# max_restart_attempts: 최대 워커 재시작 횟수
max_restart_attempts=3

# restart_cooldown_seconds: Cooldown between restart attempts
restart_cooldown_seconds=15

# monitor_local_workers: Monitor locally spawned workers
monitor_local_workers=true

# monitor_remote_workers: Monitor remote workers
monitor_remote_workers=true

# auto_restart_failed_workers: Automatically restart failed workers
auto_restart_failed_workers=true

# ===== 원격 워커 설정 (Remote Workers Configuration) =====
# 형식: ip_address,username,worker_executable_path[,ssh_port]
#
# 필드 설명:
# - ip_address: 원격 머신의 IP 주소 또는 호스트명
# - username: SSH 로그인에 사용할 사용자명
# - worker_executable_path: 원격 머신에서 워커 실행 파일의 전체 경로
# - ssh_port: SSH 포트 (선택사항, 기본값: 22)
#
# 주의사항:
# 1. SSH 키 기반 인증이 설정되어 있어야 함 (패스워드 없이 로그인 가능)
# 2. 원격 머신에 워커 실행 파일이 미리 복사되어 있어야 함
# 3. 방화벽에서 마스터 서버 포트가 허용되어야 함

# Linux/macOS 원격 워커 예시
#192.168.1.100,ubuntu,/home/ubuntu/DistributedPCProcess,22
#192.168.1.101,worker,/opt/pointcloud/worker,22
#10.0.0.50,admin,/usr/local/bin/pointcloud_worker,2222

# Windows 원격 워커 예시 (OpenSSH 서버 필요)
#192.168.1.200,Administrator,C:\Workers\DistributedPCProcess.exe,22
#192.168.1.201,pcuser,D:\Tools\pointcloud\worker.exe,22

# 클라우드 인스턴스 예시
#ec2-user@aws-instance.compute.amazonaws.com,ec2-user,/home/ec2-user/worker,22
#ubuntu@gcp-instance.compute.googleapis.com,ubuntu,/home/ubuntu/distributed_worker,22

#192.168.0.34,conworth,C:\worker\DistributedWorkersd.exe,22

# ===== 설정 가이드 =====
#
# 성능 튜닝:
# - 빠른 네트워크: 타임아웃 값들을 낮춤 (3000ms 이하)
# - 느린 네트워크: 타임아웃 값들을 높임 (10000ms 이상)
# - 많은 원격 워커: emergency_local_spawn_max를 낮춤
# - 적은 원격 워커: emergency_local_spawn_max를 높임
#
# 안정성 우선:
# - master_starvation_seconds를 높임 (60 이상)
# - ssh_connect_timeout_sec를 높임 (15 이상)
#
# 속도 우선:
# - drain_seconds를 낮춤 (3 이하)
# - worker_idle_timeout_seconds를 낮춤 (10 이하)
# - 모든 타임아웃 값을 낮춤
#
# 디버깅 모드:
# - run_local_worker_on_master=false (수동 워커 실행)
# - emergency_local_spawn_max=0 (자동 워커 생성 비활성화)
# - 모든 타임아웃 값을 높임

# ===== 사용 예시 =====
#
# 기본 로컬 실행 (원격 워커 없음):
# ./DistributedPCProcess master 8080
#
# 원격 워커 포함 실행:
# 1. 이 설정 파일에서 아래 원격 워커 라인들의 주석 해제
# 2. IP 주소와 경로를 실제 환경에 맞게 수정
# 3. ./DistributedPCProcess master 8080 실행
#
# 수동 워커 추가:
# ./DistributedPCProcess worker 192.168.1.100 8080

# 예시 원격 워커 설정 (실제 사용 시 주석 해제하고 수정)
# 192.168.1.100,user1,/home/user1/pointcloud_worker,22
# 192.168.1.101,user2,/opt/distributed/worker,22
# 10.0.0.10,admin,C:\Tools\DistributedPCProcess.exe,22
