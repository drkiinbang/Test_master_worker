# Worker Configuration
# ==============================================================================
# 
# 파일 형식 설명:
# - '#'으로 시작하는 줄은 주석
# - 'key=value' 형식의 줄은 런타임 설정
# 
# ==============================================================================

# ===== 워커 설정 (Worker Settings) =====

# worker_idle_timeout_seconds: 워커 유휴 상태 타임아웃 (초)
# 설명: 이 시간 동안 작업을 받지 못하면 워커가 자동 종료
# 권장값: 15-30초 (네트워크 안정성에 따라)
worker_idle_timeout_seconds=20

# worker_retry_max: 워커 연결 실패 시 최대 재시도 횟수
# 설명: 마스터 서버 연결 실패 시 재시도할 최대 횟수
# 권장값: 3-10회
worker_retry_max=5

# worker_retry_backoff_ms: 재시도 간격 증가량 (밀리초)
# 설명: 연결 실패 시 재시도 간격 (실패 횟수 * 이 값)
# 예: 첫 번째 실패 후 200ms, 두 번째 실패 후 400ms 대기
# 권장값: 100-500ms
worker_retry_backoff_ms=200

# worker_recv_timeout_ms: 워커 데이터 수신 타임아웃 (밀리초)
# 설명: 마스터로부터 데이터를 받을 때의 최대 대기 시간
# 권장값: 3000-10000ms (네트워크 환경에 따라)
worker_recv_timeout_ms=5000

# worker_send_timeout_ms: 워커 데이터 전송 타임아웃 (밀리초)
# 설명: 마스터로 결과를 보낼 때의 최대 대기 시간
# 권장값: 3000-10000ms
worker_send_timeout_ms=5000

# ===== 설정 가이드 =====
# 
# 성능 튜닝:
# - 빠른 네트워크: 타임아웃 값들을 낮춤 (3000ms 이하)
# - 느린 네트워크: 타임아웃 값들을 높임 (10000ms 이상)
#
# 안정성 우선:
# - worker_retry_max를 높임 (10 이상)
#
# 속도 우선:
# - worker_idle_timeout_seconds를 낮춤 (10 이하)
# - 모든 타임아웃 값을 낮춤
#
# 디버깅 모드:
# - 모든 타임아웃 값을 높임